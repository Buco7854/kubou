server {
    listen 80;
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name kubou.grimbert.net;

    ssl_certificate /etc/ssl/domains/grimbert.net/fullchain.pem;
    ssl_certificate_key /etc/ssl/domains/grimbert.net/privkey.pem;

    include /etc/nginx/server-conf.d/*.conf;

    # Root directory where your frontend build files (dist) are located
    # Make sure to run 'npm run build' in frontend/ and copy the dist folder here
    root /var/www/kubou/html;
    index index.html;

    # Frontend (Single Page Application support)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Backend API Proxy
    location /api {
        proxy_pass http://localhost:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket Proxy (for Game Sessions)
    location /ws {
        proxy_pass http://localhost:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
