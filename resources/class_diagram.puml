@startuml

package "com.kubou.domain.entity" {
    class Quiz {
        - String id
        - String title
        - List<Question> questions
        - String creatorId
        + Quiz(String id, String title, List<Question> questions)
        + Quiz(String id, String title, List<Question> questions, String creatorId)
        + getId(): String
        + getTitle(): String
        + getQuestions(): List<Question>
        + getCreatorId(): String
    }

    class Question {
        - String id
        - String text
        - List<String> options
        - int correctAnswerIndex
        - List<String> tags
        - int difficultyLevel
        - String creatorId
        + Question()
        + Question(String id, String text, List<String> options, int correctAnswerIndex, List<String> tags, int difficultyLevel)
        + Question(String id, String text, List<String> options, int correctAnswerIndex, List<String> tags, int difficultyLevel, String creatorId)
        + getId(): String
        + getText(): String
        + getOptions(): List<String>
        + getCorrectAnswerIndex(): int
        + getTags(): List<String>
        + getDifficultyLevel(): int
        + getCreatorId(): String
    }

    class GameSession {
        - String id
        - String pin
        - String quizId
        - String hostId
        - List<Player> players
        - int currentQuestionIndex
        - GameState state
        - GameConfig gameConfig
        - boolean isTeamMode
        - List<Team> teams
        - LocalDateTime currentQuestionStartTime
        + GameSession(String id, String pin, String quizId, String hostId)
        + getId(): String
        + getPin(): String
        + getQuizId(): String
        + getHostId(): String
        + getPlayers(): List<Player>
        + getCurrentQuestionIndex(): int
        + getState(): GameState
        + getGameConfig(): GameConfig
        + isTeamMode(): boolean
        + getTeams(): List<Team>
        + getCurrentQuestionStartTime(): LocalDateTime
        + addPlayer(Player player)
    }

    class Player {
        - String id
        - String userId
        - String nickname
        - int score
        - int currentStreak
        + Player(String id, String nickname)
        + Player(String id, String userId, String nickname)
        + getId(): String
        + getUserId(): String
        + getNickname(): String
        + getScore(): int
        + getCurrentStreak(): int
    }

    class Team {
        - String id
        - String name
        - int score
        - List<String> playerIds
        + Team(String id, String name)
        + getId(): String
        + getName(): String
        + getScore(): int
        + getPlayerIds(): List<String>
        + addPlayer(String playerId)
    }

    class AppUser {
        - String id
        - String username
        - String password
        - Set<String> roles
        + AppUser()
        + AppUser(String id, String username, String password, Set<String> roles)
        + getId(): String
        + getUsername(): String
        + getPassword(): String
        + getRoles(): Set<String>
    }

    class GameConfig {
        - ScoringSettings scoringSettings
        + GameConfig()
        + GameConfig(ScoringSettings scoringSettings)
        + getScoringSettings(): ScoringSettings
    }

    class ScoringSettings {
        - int baseScore
        - double timeWeight
        - double streakMultiplier
        + ScoringSettings()
        + ScoringSettings(int baseScore, double timeWeight, double streakMultiplier)
        + getBaseScore(): int
        + getTimeWeight(): double
        + getStreakMultiplier(): double
    }

    class UserAnswer {
        - String playerId
        - String questionId
        - int answerIndex
        - long timeToAnswerMs
        + UserAnswer(String playerId, String questionId, int answerIndex, long timeToAnswerMs)
        + getPlayerId(): String
        + getQuestionId(): String
        + getAnswerIndex(): int
        + getTimeToAnswerMs(): long
    }

    class PlayerResponse {
        - String id
        - String gameSessionId
        - String playerId
        - String questionId
        - int selectedAnswerIndex
        - boolean isCorrect
        - long timeTakenMs
        - int scoreAwarded
        - LocalDateTime timestamp
        + PlayerResponse(String id, String gameSessionId, String playerId, String questionId, int selectedAnswerIndex, boolean isCorrect, long timeTakenMs, int scoreAwarded, LocalDateTime timestamp)
        + getId(): String
        + getGameSessionId(): String
        + getPlayerId(): String
        + getQuestionId(): String
        + getSelectedAnswerIndex(): int
        + isCorrect(): boolean
        + getTimeTakenMs(): long
        + getScoreAwarded(): int
        + getTimestamp(): LocalDateTime
    }

    class PlayerAchievement {
        - String id
        - String playerId
        - AchievementType type
        - LocalDateTime unlockedAt
        + PlayerAchievement(String id, String playerId, AchievementType type, LocalDateTime unlockedAt)
        + getId(): String
        + getPlayerId(): String
        + getType(): AchievementType
        + getUnlockedAt(): LocalDateTime
    }

    enum GameState {
        LOBBY
        IN_PROGRESS
        QUESTION_RESULTS
        FINISHED
    }

    enum AchievementType {
        SNIPER
        FLASH
        TURBO
        LUCKY
    }
}

package "com.kubou.domain.service" {
    interface IGameModeEngine {
        + handleNextState(GameSession session, int totalQuestions): GameState
    }

    interface IScoringStrategy {
        + calculate(UserAnswer answer, Question question, GameConfig config, int currentStreak): int
    }

    class LinearQuizEngine {
        + handleNextState(GameSession session, int totalQuestions): GameState
    }

    class CustomScoringStrategy {
        + calculate(UserAnswer answer, Question question, GameConfig config, int currentStreak): int
    }
}

package "com.kubou.application.repository" {
    interface QuizRepository {
        + findById(String id): Optional<Quiz>
        + save(Quiz quiz): Quiz
        + findAll(): List<Quiz>
        + findByCreatorId(String creatorId): List<Quiz>
        + deleteById(String id)
    }

    interface UserRepository {
        + findByUsername(String username): Optional<AppUser>
        + save(AppUser user): AppUser
        + existsByUsername(String username): boolean
        + count(): long
    }

    interface QuestionRepository {
        + save(Question question): Question
        + findById(String id): Optional<Question>
        + findAll(): List<Question>
        + findAllById(List<String> ids): List<Question>
        + findByCreatorId(String creatorId): List<Question>
        + deleteById(String id)
    }

    interface GameSessionRepository {
        + findById(String id): Optional<GameSession>
        + findByPin(String pin): Optional<GameSession>
        + findByHostId(String hostId): List<GameSession>
        + findActiveSessionsByPlayerUserId(String userId): List<GameSession>
        + save(GameSession gameSession)
    }

    interface PlayerResponseRepository {
        + save(PlayerResponse response)
        + findByGameSessionId(String gameSessionId): List<PlayerResponse>
        + findByGameSessionIdAndQuestionId(String gameSessionId, String questionId): List<PlayerResponse>
        + findByPlayerId(String playerId): List<PlayerResponse>
        + findByPlayerIdAndDateRange(String playerId, LocalDateTime start, LocalDateTime end): List<PlayerResponse>
    }

    interface PlayerAchievementRepository {
        + save(PlayerAchievement achievement)
        + findByPlayerId(String playerId): List<PlayerAchievement>
        + findAll(): List<PlayerAchievement>
    }
}

package "com.kubou.application.usecase" {
    class JoinGameUseCase {
        - GameSessionJpaRepository gameSessionJpaRepository
        - GameSessionMapper gameSessionMapper
        + execute(String pin, Player player)
    }

    class StartGameUseCase {
        - GameSessionRepository gameSessionRepository
        - TeamService teamService
        + execute(String gameId, String userId): GameSession
    }

    class CreateGameUseCase {
        - GameSessionRepository gameSessionRepository
        + execute(String quizId, String hostId): GameSession
    }

    class NextQuestionUseCase {
        - GameSessionRepository gameSessionRepository
        - QuizRepository quizRepository
        - IGameModeEngine gameModeEngine
        + execute(String gameId, String userId): GameSession
    }

    class SubmitAnswerUseCase {
        - GameSessionRepository gameSessionRepository
        - QuizRepository quizRepository
        - PlayerResponseRepository playerResponseRepository
        - IScoringStrategy scoringStrategy
        + execute(String gameId, UserAnswer userAnswer): SubmitAnswerResult
    }

    class GenerateQuizUseCase {
        - QuestionRepository questionRepository
        - QuizRepository quizRepository
        - QuestionProviderFactory providerFactory
        - QuestionTranslationService translationService
        + execute(String title, String creatorId, String source, QuestionProviderRequest request): Quiz
    }

    package "dto" {
        class SubmitAnswerResult {
            - int score
            - boolean roundFinished
            - boolean isCorrect
            + SubmitAnswerResult(int score, boolean roundFinished, boolean isCorrect)
            + getScore(): int
            + isRoundFinished(): boolean
            + isCorrect(): boolean
        }
    }
}

package "com.kubou.application.service" {
    class TeamService {
        + initializeTeams(GameSession session, int numberOfTeams)
        + assignTeams(GameSession session)
        + balanceTeams(GameSession session)
    }

    class SmartReviewService {
        - PlayerResponseRepository playerResponseRepository
        - QuestionRepository questionRepository
        + getIncorrectlyAnsweredQuestionIds(String playerId): List<String>
        + createCatchUpQuiz(String playerId): List<Question>
    }

    class AchievementService {
        - PlayerAchievementRepository achievementRepository
        - QuestionRepository questionRepository
        - SimpMessagingTemplate messagingTemplate
        + checkAndUnlockAchievements(Player player, UserAnswer userAnswer, boolean isCorrect)
        + awardEndGameAchievements(GameSession session)
    }

    interface QuestionProvider {
        + fetchQuestions(QuestionProviderRequest request): List<Question>
        + getSourceIdentifier(): String
        + getSourceLanguage(): String
    }

    interface QuestionTranslationService {
        + translate(List<Question> questions, String sourceLanguage, String targetLanguage): List<Question>
    }

    class QuestionProviderFactory {
        - Map<String, QuestionProvider> providerMap
        + getProvider(String source): QuestionProvider
        + getAvailableSources(): Set<String>
    }

    class QuestionProviderRequest {
        - List<String> tags
        - int amount
        - String language
        - String text
    }

    class ExternalServiceException {
        - String serviceName
        + ExternalServiceException(String serviceName, String message)
        + getServiceName(): String
    }
}

package "com.kubou.infrastructure.provider" {
    class OpenAiQuestionProvider {
        - String apiKey
        - String baseUrl
        - String model
        + fetchQuestions(QuestionProviderRequest request): List<Question>
        + getSourceIdentifier(): String
        + getSourceLanguage(): String
    }

    class OpenTriviaDbProvider {
        + fetchQuestions(QuestionProviderRequest request): List<Question>
        + getSourceIdentifier(): String
        + getSourceLanguage(): String
    }

    class QuizApiProvider {
        - String apiKey
        + fetchQuestions(QuestionProviderRequest request): List<Question>
        + getSourceIdentifier(): String
        + getSourceLanguage(): String
    }

    class QuizzApiProvider {
        + fetchQuestions(QuestionProviderRequest request): List<Question>
        + getSourceIdentifier(): String
        + getSourceLanguage(): String
    }
}

package "com.kubou.infrastructure.repository" {
    class QuizRepositoryImpl
    class UserRepositoryImpl
    class QuestionRepositoryImpl
    class GameSessionRepositoryImpl
    class PlayerResponseRepositoryImpl
    class PlayerAchievementRepositoryImpl
}

package "com.kubou.infrastructure.repository.jpa" {
    interface QuizJpaRepository
    interface UserJpaRepository
    interface QuestionJpaRepository
    interface GameSessionJpaRepository
    interface PlayerResponseJpaRepository
    interface PlayerAchievementJpaRepository
}

package "com.kubou.infrastructure.repository.jpa.model" {
    class QuizData
    class TeamData
    class UserData
    class PlayerData
    class QuestionData
    class GameSessionData
    class PlayerResponseData
    class PlayerAchievementData
}

' Relationships

Quiz "1" *-- "0..*" Question : contains
GameSession "1" o-- "1" Quiz : references
GameSession "1" *-- "0..*" Player : contains
GameSession "1" *-- "0..*" Team : contains
GameSession "1" *-- "1" GameConfig : uses
GameSession "1" --> "1" GameState : has state
GameConfig "1" *-- "1" ScoringSettings : contains
Team "0..*" o-- "0..*" Player : references (via IDs)
PlayerAchievement "0..*" --> "1" AchievementType : has type
PlayerAchievement "0..*" --> "1" Player : belongs to (via ID)
PlayerResponse "0..*" --> "1" GameSession : belongs to (via ID)
PlayerResponse "0..*" --> "1" Player : belongs to (via ID)
PlayerResponse "0..*" --> "1" Question : answers (via ID)

LinearQuizEngine ..|> IGameModeEngine
CustomScoringStrategy ..|> IScoringStrategy

JoinGameUseCase ..> GameSessionJpaRepository : uses
JoinGameUseCase ..> GameSessionMapper : uses
StartGameUseCase ..> GameSessionRepository : uses
StartGameUseCase ..> TeamService : uses
CreateGameUseCase ..> GameSessionRepository : uses
NextQuestionUseCase ..> GameSessionRepository : uses
NextQuestionUseCase ..> QuizRepository : uses
NextQuestionUseCase ..> IGameModeEngine : uses
SubmitAnswerUseCase ..> GameSessionRepository : uses
SubmitAnswerUseCase ..> QuizRepository : uses
SubmitAnswerUseCase ..> PlayerResponseRepository : uses
SubmitAnswerUseCase ..> IScoringStrategy : uses
SubmitAnswerUseCase ..> SubmitAnswerResult : produces

SmartReviewService ..> PlayerResponseRepository : uses
SmartReviewService ..> QuestionRepository : uses

AchievementService ..> PlayerAchievementRepository : uses
AchievementService ..> QuestionRepository : uses

QuizRepositoryImpl ..|> QuizRepository
UserRepositoryImpl ..|> UserRepository
QuestionRepositoryImpl ..|> QuestionRepository
GameSessionRepositoryImpl ..|> GameSessionRepository
PlayerResponseRepositoryImpl ..|> PlayerResponseRepository
PlayerAchievementRepositoryImpl ..|> PlayerAchievementRepository

QuizRepositoryImpl ..> QuizJpaRepository : uses
UserRepositoryImpl ..> UserJpaRepository : uses
QuestionRepositoryImpl ..> QuestionJpaRepository : uses
GameSessionRepositoryImpl ..> GameSessionJpaRepository : uses
PlayerResponseRepositoryImpl ..> PlayerResponseJpaRepository : uses
PlayerAchievementRepositoryImpl ..> PlayerAchievementJpaRepository : uses

GameSessionJpaRepository ..> GameSessionData : manages
QuizJpaRepository ..> QuizData : manages
UserJpaRepository ..> UserData : manages
QuestionJpaRepository ..> QuestionData : manages
PlayerResponseJpaRepository ..> PlayerResponseData : manages
PlayerAchievementJpaRepository ..> PlayerAchievementData : manages

GameSessionData *-- PlayerData : contains
GameSessionData *-- TeamData : contains

GenerateQuizUseCase ..> QuestionRepository : uses
GenerateQuizUseCase ..> QuizRepository : uses
GenerateQuizUseCase ..> QuestionProviderFactory : uses
GenerateQuizUseCase ..> QuestionTranslationService : uses

QuestionProviderFactory ..> QuestionProvider : manages

OpenAiQuestionProvider ..|> QuestionProvider
OpenTriviaDbProvider ..|> QuestionProvider
QuizApiProvider ..|> QuestionProvider
QuizzApiProvider ..|> QuestionProvider

@enduml
