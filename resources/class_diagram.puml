@startuml

package "com.kubou.domain.entity" {

    class AppUser {
        - String id
        - String username
        - String password
        - Set<String> roles
        + AppUser()
        + AppUser(String, String, String, Set<String>)
        + getId(): String
        + setId(String)
        + getUsername(): String
        + setUsername(String)
        + getPassword(): String
        + setPassword(String)
        + getRoles(): Set<String>
        + setRoles(Set<String>)
    }

    class GameConfig {
        - ScoringSettings scoringSettings
        + GameConfig()
        + GameConfig(ScoringSettings)
        + getScoringSettings(): ScoringSettings
        + setScoringSettings(ScoringSettings)
    }

    class GameSession {
        - String id
        - String pin
        - String quizId
        - String hostId
        - List<Player> players
        - int currentQuestionIndex
        - GameState state
        - GameConfig gameConfig
        - boolean isTeamMode
        - List<Team> teams
        - LocalDateTime currentQuestionStartTime
        + GameSession(String, String, String, String)
        + getId(): String
        + setId(String)
        + getPin(): String
        + setPin(String)
        + getQuizId(): String
        + setQuizId(String)
        + getHostId(): String
        + setHostId(String)
        + getPlayers(): List<Player>
        + setPlayers(List<Player>)
        + getCurrentQuestionIndex(): int
        + setCurrentQuestionIndex(int)
        + getState(): GameState
        + setState(GameState)
        + getGameConfig(): GameConfig
        + setGameConfig(GameConfig)
        + isTeamMode(): boolean
        + setTeamMode(boolean)
        + getTeams(): List<Team>
        + setTeams(List<Team>)
        + getCurrentQuestionStartTime(): LocalDateTime
        + setCurrentQuestionStartTime(LocalDateTime)
        + addPlayer(Player)
    }

    enum GameState {
        LOBBY
        IN_PROGRESS
        QUESTION_RESULTS
        FINISHED
    }

    class Player {
        - String id
        - String userId
        - String nickname
        - int score
        - int currentStreak
        + Player(String, String)
        + Player(String, String, String)
        + getId(): String
        + setId(String)
        + getUserId(): String
        + setUserId(String)
        + getNickname(): String
        + setNickname(String)
        + getScore(): int
        + setScore(int)
        + getCurrentStreak(): int
        + setCurrentStreak(int)
    }

    class PlayerAchievement {
        - String id
        - String playerId
        - AchievementType type
        - LocalDateTime unlockedAt
        + PlayerAchievement(String, String, AchievementType, LocalDateTime)
        + getId(): String
        + getPlayerId(): String
        + getType(): AchievementType
        + getUnlockedAt(): LocalDateTime
    }

    enum AchievementType {
        SNIPER
        FLASH
        TURBO
        LUCKY
        - String name
        - String description
        + getName(): String
        + getDescription(): String
    }

    class PlayerResponse {
        - String id
        - String gameSessionId
        - String playerId
        - String questionId
        - int selectedAnswerIndex
        - boolean isCorrect
        - long timeTakenMs
        - int scoreAwarded
        - LocalDateTime timestamp
        + PlayerResponse(String, String, String, String, int, boolean, long, int, LocalDateTime)
        + getId(): String
        + getGameSessionId(): String
        + getPlayerId(): String
        + getQuestionId(): String
        + getSelectedAnswerIndex(): int
        + isCorrect(): boolean
        + getTimeTakenMs(): long
        + getScoreAwarded(): int
        + getTimestamp(): LocalDateTime
    }

    class Question {
        - String id
        - String text
        - List<String> options
        - int correctAnswerIndex
        - List<String> tags
        - int difficultyLevel
        - String creatorId
        + Question()
        + Question(String, String, List<String>, int, List<String>, int)
        + Question(String, String, List<String>, int, List<String>, int, String)
        + getId(): String
        + setId(String)
        + getText(): String
        + setText(String)
        + getOptions(): List<String>
        + setOptions(List<String>)
        + getCorrectAnswerIndex(): int
        + setCorrectAnswerIndex(int)
        + getTags(): List<String>
        + setTags(List<String>)
        + getDifficultyLevel(): int
        + setDifficultyLevel(int)
        + getCreatorId(): String
        + setCreatorId(String)
    }

    class Quiz {
        - String id
        - String title
        - List<Question> questions
        - String creatorId
        + Quiz(String, String, List<Question>)
        + Quiz(String, String, List<Question>, String)
        + getId(): String
        + setId(String)
        + getTitle(): String
        + setTitle(String)
        + getQuestions(): List<Question>
        + setQuestions(List<Question>)
        + getCreatorId(): String
        + setCreatorId(String)
    }

    class ScoringSettings {
        - int baseScore
        - double timeWeight
        - double streakMultiplier
        + ScoringSettings()
        + ScoringSettings(int, double, double)
        + getBaseScore(): int
        + setBaseScore(int)
        + getTimeWeight(): double
        + setTimeWeight(double)
        + getStreakMultiplier(): double
        + setStreakMultiplier(double)
    }

    class Team {
        - String id
        - String name
        - int score
        - List<String> playerIds
        + Team(String, String)
        + getId(): String
        + setId(String)
        + getName(): String
        + setName(String)
        + getScore(): int
        + setScore(int)
        + getPlayerIds(): List<String>
        + setPlayerIds(List<String>)
        + addPlayer(String)
    }

    class UserAnswer {
        - String playerId
        - String questionId
        - int answerIndex
        - long timeToAnswerMs
        + UserAnswer(String, String, int, long)
        + getPlayerId(): String
        + setPlayerId(String)
        + getQuestionId(): String
        + setQuestionId(String)
        + getAnswerIndex(): int
        + setAnswerIndex(int)
        + getTimeToAnswerMs(): long
        + setTimeToAnswerMs(long)
    }

    ' Relationships
    GameSession "1" *-- "1" GameConfig
    GameSession "1" *-- "*" Player
    GameSession "1" *-- "*" Team
    GameSession "1" o-- "1" GameState
    GameConfig "1" *-- "1" ScoringSettings
    Quiz "1" *-- "*" Question
    PlayerAchievement "*" o-- "1" AchievementType
    
    ' Associations (by ID references)
    GameSession ..> Quiz : references quizId
    GameSession ..> AppUser : references hostId
    Player ..> AppUser : references userId (optional)
    Team ..> Player : references playerIds
    PlayerResponse ..> GameSession : references gameSessionId
    PlayerResponse ..> Player : references playerId
    PlayerResponse ..> Question : references questionId
    UserAnswer ..> Player : references playerId
    UserAnswer ..> Question : references questionId
    PlayerAchievement ..> Player : references playerId
    Quiz ..> AppUser : references creatorId
    Question ..> AppUser : references creatorId

}

package "com.kubou.domain.service" {
    interface IGameModeEngine {
        + handleNextState(GameSession, int): GameState
    }

    interface IScoringStrategy {
        + calculate(UserAnswer, Question, GameConfig, int): int
    }

    class LinearQuizEngine {
        + handleNextState(GameSession, int): GameState
    }

    class CustomScoringStrategy {
        + calculate(UserAnswer, Question, GameConfig, int): int
    }

    IGameModeEngine <|.. LinearQuizEngine
    IScoringStrategy <|.. CustomScoringStrategy
    
    ' Dependencies
    IGameModeEngine ..> GameSession
    IGameModeEngine ..> GameState
    IScoringStrategy ..> UserAnswer
    IScoringStrategy ..> Question
    IScoringStrategy ..> GameConfig
}

@enduml
