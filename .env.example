# PostgreSQL
POSTGRES_USER=kubou
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kubou
POSTGRES_PORT=5432

# Backend (uses postgres service name as host inside Docker)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/kubou
SPRING_DATASOURCE_USERNAME=kubou
SPRING_DATASOURCE_PASSWORD=change-me
JWT_SECRET=change-me-use-a-long-random-hex-string
JWT_EXPIRATION_MS=86400000
QUIZAPI_KEY=your-api-key-here
BACKEND_PORT=8080

# Frontend
FRONTEND_PORT=80
